CONFIG_POSITION_INDEPENDENT=y
# CONFIG_COMPRESS_GZIP is not set
CONFIG_EXYNOS_9610=y
CONFIG_SAMSUNG_A51=y
CONFIG_TEXT_BASE=0x88000000
CONFIG_PAYLOAD_ENTRY=0x90000000
CONFIG_RAMDISK_ENTRY=0x84000000
# loader log after the kernel's in the ramoops console zone (stock and mainline
# geometry: 2M @0xf9d10000, 512K zones, console 2nd)
CONFIG_RAMLOG=y
CONFIG_RAMLOG_ADDR=0xf9d90000
CONFIG_RAMLOG_SIZE=0x80000
# dead power key: watchdog + escape. Slot 1 = RECOVERY (escape to BOOT); the
# scratch page is the last page of the debug-snapshot kevents area
CONFIG_FAILSAFE=y
CONFIG_FAILSAFE_SLOT=1
CONFIG_FAILSAFE_SCRATCH_ADDR=0xfa70f000
# no banner, keep the S-BOOT logo: loader text is drawn over it
CONFIG_NO_SPLASH=y
CONFIG_SIMPLE_FB_KEEP_SCREEN=y
